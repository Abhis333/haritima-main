# ---- Database (Neon / Supabase PostgreSQL) ----
DATABASE_URL=""

# ---- Auth.js ----  generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ---- AI (server-side only) ----
# Default provider is Google Gemini (free tier works for a student project).
AI_API_KEY=
AI_CHAT_MODEL=gemini-3.1-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Plant identification (Pl@ntNet API, free for academic use: https://my.plantnet.org) ----
PLANTNET_API_KEY=

# ---- Map tiles (public, no secret) ----
NEXT_PUBLIC_MAP_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ---- Cloudinary (server-side only) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- First admin (used by: npm run create-admin) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Haritima Admin"

# Optional: campus centre for the map (defaults to approx. DSVV, Haridwar)
NEXT_PUBLIC_CAMPUS_LAT=29.9985
NEXT_PUBLIC_CAMPUS_LNG=78.1985
