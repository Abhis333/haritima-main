# ---- Database (PostgreSQL: Railway, Neon or Supabase) ----
# Railway: use the PUBLIC connection URL (Postgres service → Connect → Public network) when running locally;
# inside Railway, reference it as ${{Postgres.DATABASE_URL}}.
# Neon pooled (pgbouncer) URL: append &pgbouncer=true&connect_timeout=30&pool_timeout=30
DATABASE_URL=""

# ---- Auth.js ----  generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Public site address. Required behind a proxy (Railway), otherwise Auth.js may see the internal host (localhost:8080).
AUTH_URL=

# ---- AI (server-side only) ----
# Google Gemini: always used for embeddings (vector search), and for answers unless Groq is selected.
# Free key: https://aistudio.google.com/apikey
AI_API_KEY=
AI_CHAT_MODEL=gemini-3.1-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-001

# Groq (optional): set AI_CHAT_PROVIDER=groq to write answers with Groq; Gemini stays the fallback.
# Free key: https://console.groq.com/keys . Check the console's model list for current model names.
AI_CHAT_PROVIDER=gemini
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ---- Plant identification (Pl@ntNet API, free for academic use: https://my.plantnet.org) ----
PLANTNET_API_KEY=

# ---- Map tiles (public, no secret) ----
# Leave empty for the muted CARTO basemap; set a tile URL template to override it.
NEXT_PUBLIC_MAP_URL=

# ---- Cloudinary (server-side only) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- First admin (used by: npm run create-admin) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Haritima Admin"

# Optional: campus centre for the map (defaults to approx. DSVV, Haridwar)
NEXT_PUBLIC_CAMPUS_LAT=29.998143
NEXT_PUBLIC_CAMPUS_LNG=78.192779
